# Copy to .env and adjust. Nothing here is required for llm_backend=claude_cli,
# which shells out to the locally authenticated `claude` CLI.

DEBUG=false

# claude_cli | anthropic_api | replay
LLM_BACKEND=claude_cli
LLM_MODEL=haiku
LLM_TIMEOUT_S=30

# Only used when LLM_BACKEND=anthropic_api
ANTHROPIC_API_KEY=

# Anchors "today" for deterministic date resolution and demos.
# Leave unset to use the real wall-clock date. The seeded dataset's own
# demo window starts 2026-09-02 — set this to match when demoing against it.
TODAY_OVERRIDE=2026-09-02

CORS_ORIGINS=["http://localhost:5173"]
