# Copy to .env and adjust. Choose one backend and a model it supports.

DEBUG=false

# codex_cli | claude_cli | vertex
LLM_BACKEND=codex_cli
LLM_MODEL=gpt-5.6-terra
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_S=90

# Vertex AI only. Set LLM_BACKEND=vertex and, for example,
# LLM_MODEL=gemini-2.5-flash. Use either an Express API key or standard Google
# Cloud authentication. For standard auth, set VERTEX_PROJECT and authenticate
# with ADC (`gcloud auth application-default login`) or provide a credential file.
VERTEX_PROJECT=
VERTEX_LOCATION=global
VERTEX_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Anchors "today" for deterministic date resolution and demos. If unset, the
# app uses the seeded catalogue date; keeping it explicit makes the demo obvious.
TODAY_OVERRIDE=2026-09-02

CORS_ORIGINS=["http://localhost:5173"]
